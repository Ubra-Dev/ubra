{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ubra",
  "version": "0.1.0",
  "identifier": "com.nemoryoliver.ubra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ubra",
        "width": 1200,
        "height": 800,
        "theme": "Dark",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://*.posthog.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://*.posthog.com; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/stackwares/ubra-tauri/releases/latest/download/latest.json"
      ]
    }
  }
}
